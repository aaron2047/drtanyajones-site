# Optional. Without these the API logs inquiries to the server console (preview mode).
RESEND_API_KEY=
INQUIRY_FROM=inquiries@example.com
# Routing: where each inquiry type is sent
INQUIRY_TO_FORUM=
INQUIRY_TO_KEYNOTE=
INQUIRY_TO_TRAINING=
INQUIRY_TO_PROBONO=
INQUIRY_TO_OTHER=
# Hero video (Mux/Cloudflare Stream MP4 or HLS-compatible URL) and poster image
NEXT_PUBLIC_HERO_VIDEO=
NEXT_PUBLIC_HERO_POSTER=
# Headless Shopify (Headless channel → Storefront API). Leave empty to show the local preview catalog.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
# Which store runs the shop: wix (existing Interactive Advocacy Wix Store), shopify, or empty for the preview catalog.
COMMERCE_PROVIDER=
NEXT_PUBLIC_COMMERCE=
# Wix Headless OAuth app client ID (Wix dashboard → Settings → Headless Settings)
WIX_CLIENT_ID=
